---
import Base from "../layouts/Base.astro";
---
<Base title="KabisLab Blog" description="Engineering, data, and product notes from KabisLab">
  <h1 style="font-size:2rem; line-height:1.2;">KabisLab Blog</h1>
  <p style="color:#444;">MVP scaffold. Content and visual polish to follow.</p>

  <section style="margin-top:2rem;">
    <h2>Welcome</h2>
    <p>
      This is the minimal Astro-based blog foundation. Markdown/MDX posts, RSS, sitemap,
      and theming can be layered in incrementally.
    </p>
  </section>
</Base>
